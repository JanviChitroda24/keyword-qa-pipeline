# Copy this file to .env and fill in your real values.
# .env is loaded automatically by ensemble_pipeline_v2.py, acronym_pipeline.py,
# prepare_production.py, update_fixed_definitions.py, and ensemble_pipeline_prod.py.

# Required for Stages 11 / 22 (API scoring) — Mistral Small
MISTRAL_API_KEY=your_mistral_key

# Required for Stages 11 / 22 (API scoring) — OpenAI GPT-4o-mini
OPENAI_API_KEY=sk-...

# Required for all Supabase stages (10–18, 21–24)
# Use the service_role key, NOT the anon key
QA_SUPABASE_URL=https://your-project.supabase.co
QA_SUPABASE_KEY=eyJ...
